#!/usr/bin/env bash
# Painel tmux de diagnóstico de rede: gateway, internet, DNS, HTTP e rota lado a lado.

set -euo pipefail

SESSION="pt"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

# ---------------------------------------------------------------------------
# Painéis (executados pelo próprio script dentro do tmux via --pane <tipo>)
# ---------------------------------------------------------------------------

header() { printf '== %s ==\n' "$*"; }
ok()     { printf '\n✅ %s\n' "$*"; }
fail()   { printf '\n❌ %s\n' "$*"; }
info()   { printf '\nℹ️  %s\n' "$*"; }
warn()   { printf '\n⚠️  %s\n' "$*"; }

# Comparação e formatação de decimais (o bash só lida com inteiros)
gt()  { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }
num() { awk -v x="$1" 'BEGIN { printf "%.1f", x }'; }

# Gateway local: separa problema na rede local (Wi-Fi/cabo) de problema no provedor
pane_gateway() {
    local gw="${1:-}"
    case "$gw" in
        "")
            info "Could not detect the gateway. Set PT_GATEWAY=<ip> to test it."
            return ;;
        no-route)
            fail "No default route: no connection to the local network (Wi-Fi, cable or DHCP)."
            return ;;
        no-via)
            info "Default route has no gateway (VPN or point-to-point link); test does not apply."
            return ;;
    esac
    header "Local gateway: $gw"
    if ping -c5 "$gw"; then
        ok "Local network OK."
    else
        fail "Gateway not responding: local network problem (some routers block ICMP; compare with the other panes)."
    fi
}

# DNS: compara o resolvedor do sistema com um servidor externo
pane_dns() {
    local host="$1" server="$2" out status answers sys="" ext=""
    local -a limit=()
    command -v timeout >/dev/null 2>&1 && limit=(timeout 6)

    header "System DNS: $host"
    if ! command -v getent >/dev/null 2>&1; then
        echo "(getent not found: system DNS test skipped)"
    elif out=$("${limit[@]}" getent hosts "$host") && [[ -n "$out" ]]; then
        echo "$out"
        sys="ok"
    else
        echo "(no response)"
        sys="error"
    fi

    echo
    header "External DNS: @$server"
    if command -v dig >/dev/null 2>&1; then
        out=$(dig +time=3 +tries=1 +noall +comments +answer "@$server" "$host" A 2>&1) || true
        status=$(sed -n 's/.*status: \([A-Z]*\).*/\1/p' <<<"$out" | head -n1)
        answers=$(awk '!/^;/ && NF { print $NF }' <<<"$out")
        if [[ "$status" == NOERROR && -n "$answers" ]]; then
            echo "$answers"
            ext="ok"
        elif [[ "$status" == NXDOMAIN ]]; then
            echo "NXDOMAIN (name does not exist)"
            ext="nx"
        elif [[ -n "$status" ]]; then
            echo "Response: $status"
            ext="error"
        else
            echo "(no response)"
            ext="error"
        fi
    else
        echo "(dig not found: install dnsutils/bind-utils for this test)"
    fi

    echo
    header "Ping by name: $host"
    ping -c3 "$host" || true

    if [[ "$sys" == ok ]]; then
        ok "System DNS OK."
    elif [[ "$ext" == nx ]]; then
        fail "The name $host does not exist (NXDOMAIN): check the target in PT_PING_DNS."
    elif [[ "$ext" == ok && "$sys" == error ]]; then
        fail "System DNS failed, but the external one responds: problem with the configured resolver (router DNS or /etc/resolv.conf)."
    elif [[ "$ext" == ok ]]; then
        ok "External DNS OK (system DNS not tested)."
    elif [[ "$ext" == error ]]; then
        fail "No DNS server responded: no internet or port 53 blocked."
    elif [[ "$sys" == error ]]; then
        fail "System DNS failed."
    else
        info "Neither getent nor dig available: see the ping by name result above."
    fi
}

# HTTP(S): funciona mesmo onde ICMP é bloqueado e detecta portal cativo/proxy
pane_http() {
    local url="$1" portal="$2" out code="" code_https t_conn t_total https_ok=0

    if ! command -v curl >/dev/null 2>&1; then
        fail "curl not found: install curl for this test."
        return
    fi

    header "HTTPS: $url"
    if out=$(curl -sS -o /dev/null --max-time 10 \
            -w '%{http_code} %{time_connect} %{time_total}' "$url"); then
        read -r code_https t_conn t_total <<<"$out"
        echo "HTTP $code_https · connect ${t_conn}s · total ${t_total}s"
        https_ok=1
    fi

    echo
    header "Captive portal: $portal"
    code=$(curl -sS -o /dev/null --max-time 10 -w '%{http_code}' "$portal") || code=""
    echo "HTTP ${code:-no response} (expected: 204)"

    if [[ "$code" == 204 ]] && (( https_ok )); then
        ok "Web access OK, no captive portal."
    elif [[ -n "$code" && "$code" != 204 ]]; then
        fail "Unexpected response ($code): likely a captive portal (public/hotel Wi-Fi) or an intercepting proxy."
    elif (( https_ok )); then
        ok "HTTPS OK (captive portal check got no response)."
    else
        fail "No web access: if pings work, a proxy or firewall may be blocking HTTP(S)."
    fi
}

# Internet via ICMP: além de responder, avalia perda, latência média e oscilação (jitter)
pane_ping() {
    local host="$1" slow="$2" very_slow="$3" jitter_max="$4" out loss stats min avg max mdev
    local -a issues=()

    header "Ping: $host"
    # Mostra as respostas ao vivo e guarda a saída para o veredito (LC_ALL=C: formato previsível)
    out=$(LC_ALL=C ping -c5 "$host" | tee /dev/stderr) || true
    loss=$(sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p' <<<"$out")
    stats=$(sed -n 's/^rtt [^=]*= \([0-9.\/]*\) ms.*/\1/p' <<<"$out")

    if [[ -z "$stats" ]]; then
        fail "No reply from $host: no internet or ICMP blocked (compare with the HTTP pane)."
        return
    fi
    IFS=/ read -r min avg max mdev <<<"$stats"
    printf '\nLoss %s%% · avg %s ms · min %s · max %s · jitter %s ms\n' \
        "${loss:-?}" "$(num "$avg")" "$(num "$min")" "$(num "$max")" "$(num "$mdev")"

    if gt "$avg" "$very_slow"; then
        issues+=("very slow (avg $(num "$avg") ms, above $very_slow ms)")
    elif gt "$avg" "$slow"; then
        issues+=("a bit slow (avg $(num "$avg") ms, ideally up to $slow ms)")
    fi
    if gt "${loss:-0}" 0; then
        issues+=("losing packets (${loss}%)")
    fi
    if gt "$mdev" "$jitter_max"; then
        issues+=("latency is unstable (jitter $(num "$mdev") ms, peak $(num "$max") ms)")
    fi

    if (( ${#issues[@]} == 0 )); then
        ok "Internet OK: avg $(num "$avg") ms, no packet loss."
    else
        local msg
        msg=$(printf '%s; ' "${issues[@]}")
        warn "Internet working, but ${msg%; }."
    fi
}

# Rota: traceroute quando disponível, senão tracepath (iputils, não exige root)
pane_route() {
    if command -v traceroute >/dev/null 2>&1; then
        traceroute -n "$1"
    else
        tracepath -n "$1"
    fi
}

if [[ "${1:-}" == "--pane" ]]; then
    kind="${2:-}"
    shift 2 || true
    case "$kind" in
        gateway) pane_gateway "$@" ;;
        ping)    pane_ping "$@" ;;
        dns)     pane_dns "$@" ;;
        http)    pane_http "$@" ;;
        route)   pane_route "$@" ;;
        *)       echo "Unknown pane: $kind" >&2; exit 1 ;;
    esac
    exit 0
fi

# ---------------------------------------------------------------------------
# Configuração e criação da sessão
# ---------------------------------------------------------------------------

# Gateway da rota padrão (IPv4, senão IPv6). Imprime o IP, "no-via" se a rota não
# tiver gateway (VPN), "no-route" se não houver rota padrão, ou nada se não der para saber
detect_gateway() {
    local fam routes gw dest hex
    if command -v ip >/dev/null 2>&1; then
        for fam in -4 -6; do
            routes=$(ip "$fam" route show default 2>/dev/null) || continue
            [[ -n "$routes" ]] || continue
            # Também cobre rotas multipath ("nexthop via ..."); IPv6 link-local precisa da interface
            gw=$(awk '{
                    via = ""; dev = ""
                    for (i = 1; i < NF; i++) {
                        if ($i == "via") via = $(i + 1)
                        if ($i == "dev") dev = $(i + 1)
                    }
                    if (via != "") {
                        if (via ~ /^fe80:/ && dev != "") via = via "%" dev
                        print via
                        exit
                    }
                }' <<<"$routes")
            echo "${gw:-no-via}"
            return
        done
        echo "no-route"
        return
    fi
    # Sem iproute2: lê a tabela IPv4 do kernel (gateway em hexadecimal little-endian).
    # Sem rota IPv4 aqui não dá para concluir nada, pois pode haver só IPv6
    [[ -r /proc/net/route ]] || return 0
    while read -r _ dest hex _; do
        [[ "$dest" == 00000000 ]] || continue
        if [[ "$hex" == 00000000 ]]; then
            echo "no-via"
        else
            printf '%d.%d.%d.%d\n' "0x${hex:6:2}" "0x${hex:4:2}" "0x${hex:2:2}" "0x${hex:0:2}"
        fi
        return
    done < <(tail -n +2 /proc/net/route)
}

# Destinos (podem ser sobrescritos por variáveis de ambiente)
GATEWAY="${PT_GATEWAY:-$(detect_gateway)}"
PING_1="${PT_PING_1:-1.1.1.1}"
PING_2="${PT_PING_2:-8.8.8.8}"
PING_DNS="${PT_PING_DNS:-google.com}"
DNS_SERVER="${PT_DNS_SERVER:-1.1.1.1}"
HTTP_URL="${PT_HTTP_URL:-https://www.cloudflare.com}"
PORTAL_URL="${PT_PORTAL_URL:-http://connectivitycheck.gstatic.com/generate_204}"
TRACE="${PT_TRACE:-8.8.8.8}"

# Limites de latência em ms para os painéis de ping (inteiros; valor inválido usa o padrão)
int_or() { [[ "$1" =~ ^[0-9]+$ ]] && echo "$1" || echo "$2"; }
LAT_SLOW=$(int_or "${PT_LAT_SLOW:-}" 60)
LAT_VERY_SLOW=$(int_or "${PT_LAT_VERY_SLOW:-}" 150)
JITTER_MAX=$(int_or "${PT_JITTER:-}" 30)

case "$GATEWAY" in
    "")       GATEWAY_LABEL="(not detected)" ;;
    no-route) GATEWAY_LABEL="(no default route)" ;;
    no-via)  GATEWAY_LABEL="(route without gateway)" ;;
    *)        GATEWAY_LABEL="$GATEWAY" ;;
esac

if command -v traceroute >/dev/null 2>&1; then ROUTE_TOOL="traceroute"; else ROUTE_TOOL="tracepath"; fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<EOF
Usage: $(basename "$0")

Opens the tmux session '$SESSION' with six diagnostic panes:
  Gateway   ping -c5 $GATEWAY_LABEL
  Ping      ping -c5 $PING_1
  Ping      ping -c5 $PING_2
  DNS       $PING_DNS via system DNS and @$DNS_SERVER
  HTTP      $HTTP_URL + captive portal check
  Route     $ROUTE_TOOL -n $TRACE

Ping latency: OK up to ${LAT_SLOW} ms, very slow above ${LAT_VERY_SLOW} ms,
unstable with jitter above ${JITTER_MAX} ms.

Environment variables: PT_GATEWAY, PT_PING_1, PT_PING_2, PT_PING_DNS,
PT_DNS_SERVER, PT_HTTP_URL, PT_PORTAL_URL, PT_TRACE,
PT_LAT_SLOW, PT_LAT_VERY_SLOW, PT_JITTER
EOF
    exit 0
fi

# Verifica dependências obrigatórias (dig e curl são opcionais)
missing=()
for cmd in tmux ping; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
if ! command -v traceroute >/dev/null 2>&1 && ! command -v tracepath >/dev/null 2>&1; then
    missing+=("traceroute or tracepath")
fi
if (( ${#missing[@]} )); then
    echo "Error: missing dependencies: ${missing[*]}" >&2
    echo "See the README for installation instructions." >&2
    exit 1
fi

# Monta o comando de um painel; ao terminar, o painel cai na shell do usuário
pane_cmd() {
    local cmd
    printf -v cmd '%q ' "$@"
    printf '%s; exec %q' "$cmd" "${SHELL:-bash}"
}

# O prefixo '=' força correspondência exata do nome da sessão
# (sem ele, '-t pt' casaria com qualquer sessão iniciada por "pt", ex.: "ptolemy")
TARGET="=$SESSION"

# Renomeia a sessão anterior em vez de encerrá-la já: se o script estiver rodando
# dentro dela, encerrá-la agora mataria o próprio script antes de criar a nova
OLD=""
if tmux has-session -t "$TARGET" 2>/dev/null; then
    OLD="${SESSION}-old-$$"
    tmux rename-session -t "$TARGET" "$OLD"
fi

# Cria a nova sessão e armazena os IDs únicos dos painéis (compatível com base-index 0 e 1)
if ! LAST=$(tmux new-session -d -s "$SESSION" -P -F '#{pane_id}' \
        "$(pane_cmd "$SELF" --pane gateway "$GATEWAY")"); then
    echo "Error: could not create the tmux session '$SESSION'." >&2
    [[ -n "$OLD" ]] && tmux rename-session -t "=$OLD" "$SESSION"
    exit 1
fi
FIRST="$LAST"
tmux set-option -p -t "$LAST" @pt_title "Gateway $GATEWAY_LABEL" 2>/dev/null || true

# Adiciona um painel após o último e reorganiza em grade a cada passo,
# para que a sessão (criada com tamanho padrão) sempre tenha espaço
add_pane() {
    local title="$1"
    shift
    LAST=$(tmux split-window -t "$LAST" -P -F '#{pane_id}' "$(pane_cmd "$@")")
    tmux select-layout -t "$LAST" tiled >/dev/null
    tmux set-option -p -t "$LAST" @pt_title "$title" 2>/dev/null || true
}

add_pane "Ping $PING_1"     "$SELF" --pane ping "$PING_1" "$LAT_SLOW" "$LAT_VERY_SLOW" "$JITTER_MAX"
add_pane "Ping $PING_2"     "$SELF" --pane ping "$PING_2" "$LAT_SLOW" "$LAT_VERY_SLOW" "$JITTER_MAX"
add_pane "DNS $PING_DNS"    "$SELF" --pane dns "$PING_DNS" "$DNS_SERVER"
add_pane "HTTP"             "$SELF" --pane http "$HTTP_URL" "$PORTAL_URL"
add_pane "Route $TRACE ($ROUTE_TOOL)" "$SELF" --pane route "$TRACE"

tmux select-pane -t "$FIRST"

# Desativa a barra de status e identifica cada painel na borda superior
tmux set-option -t "$TARGET" status off >/dev/null 2>&1 || true
tmux set-option -w -t "$TARGET:" pane-border-status top >/dev/null 2>&1 || true
tmux set-option -w -t "$TARGET:" pane-border-format ' #{@pt_title} ' >/dev/null 2>&1 || true

# Conecta à sessão e só então descarta a anterior
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$TARGET" 2>/dev/null || true
    # Último passo: se o script roda dentro da sessão antiga, ele termina aqui
    [[ -n "$OLD" ]] && tmux kill-session -t "=$OLD" 2>/dev/null
    exit 0
else
    [[ -n "$OLD" ]] && tmux kill-session -t "=$OLD" 2>/dev/null
    exec tmux attach-session -t "$TARGET"
fi
