#!/usr/bin/env bash

SESSION="pt"

# Encerra a sessão antiga, caso exista
tmux kill-session -t "$SESSION" 2>/dev/null || true

# Cria a nova sessão e armazena os IDs únicos dos painéis (compatível com base-index 0 e 1)
P1=$(tmux new-session -d -s "$SESSION" -P -F '#{pane_id}' 'ping -c5 1.1.1.1; exec bash')
P2=$(tmux split-window -h -t "$P1" -P -F '#{pane_id}' 'ping -c5 8.8.8.8; exec bash')
P3=$(tmux split-window -v -t "$P1" -P -F '#{pane_id}' 'ping -c5 google.com; exec bash')
P4=$(tmux split-window -v -t "$P2" -P -F '#{pane_id}' 'traceroute 8.8.8.8; exec bash')

# Organiza o layout em grid 2x2
tmux select-layout -t "$SESSION" tiled 2>/dev/null || true
tmux select-pane -t "$P1"

# Desativa a barra de status para exibição limpa
tmux set-option -t "$SESSION" status off 2>/dev/null || true

# Conecta à sessão
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
else
    tmux attach-session -t "$SESSION"
fi
