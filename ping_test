ADVANCED=0
SHOW_HELP=0
for arg in "$@"; do
    case "$arg" in
        -a|--advanced) ADVANCED=1 ;;
        -h|--help)     SHOW_HELP=1 ;;
        *)
            echo "Error: unknown option: $arg" >&2
            echo "" >&2
            echo "💡 Most likely fix: use one of the supported options." >&2
            echo "     \$ $(basename "$0") --help" >&2
            exit 1 ;;
    esac
done

# Gateway da rota padrão (IPv4, senão IPv6). Imprime o IP, "no-via" se a rota não
# tiver gateway (VPN), "no-route" se não houver rota padrão, ou nada se não der para saber
detect_gateway() {
    local fam routes gw dest hex
    if command -v ip >/dev/null 2>&1; then
        for fam in -4 -6; do
            routes=$(ip "$fam" route show default 2>/dev/null) || continue
            [[ -n "$routes" ]] || continue
            # Também cobre rotas multipath ("nexthop via ..."); IPv6 link-local precisa da interface
            gw=$(awk '{
                    via = ""; dev = ""
                    for (i = 1; i < NF; i++) {
                        if ($i == "via") via = $(i + 1)
                        if ($i == "dev") dev = $(i + 1)
                    }
                    if (via != "") {
                        if (via ~ /^fe80:/ && dev != "") via = via "%" dev
                        print via
                        exit
                    }
                }' <<<"$routes")
            echo "${gw:-no-via}"
            return
        done
        echo "no-route"
        return
    fi
    # Sem iproute2: lê a tabela IPv4 do kernel (gateway em hexadecimal little-endian).
    # Sem rota IPv4 aqui não dá para concluir nada, pois pode haver só IPv6
    [[ -r /proc/net/route ]] || return 0
    while read -r _ dest hex _; do
        [[ "$dest" == 00000000 ]] || continue
        if [[ "$hex" == 00000000 ]]; then
            echo "no-via"
        else
            printf '%d.%d.%d.%d\n' "0x${hex:6:2}" "0x${hex:4:2}" "0x${hex:2:2}" "0x${hex:0:2}"
        fi
        return
    done < <(tail -n +2 /proc/net/route)
}

# Destinos (podem ser sobrescritos por variáveis de ambiente)
GATEWAY="${PT_GATEWAY:-$(detect_gateway)}"
PING_1="${PT_PING_1:-1.1.1.1}"
PING_2="${PT_PING_2:-8.8.8.8}"
PING_DNS="${PT_PING_DNS:-google.com}"
DNS_SERVER="${PT_DNS_SERVER:-1.1.1.1}"
HTTP_URL="${PT_HTTP_URL:-https://www.cloudflare.com}"
PORTAL_URL="${PT_PORTAL_URL:-http://connectivitycheck.gstatic.com/generate_204}"
TRACE="${PT_TRACE:-8.8.8.8}"

# Limites de latência em ms para os painéis de ping (inteiros; valor inválido usa o padrão)
int_or() { [[ "$1" =~ ^[0-9]+$ ]] && echo "$1" || echo "$2"; }
LAT_SLOW=$(int_or "${PT_LAT_SLOW:-}" 60)
LAT_VERY_SLOW=$(int_or "${PT_LAT_VERY_SLOW:-}" 150)
JITTER_MAX=$(int_or "${PT_JITTER:-}" 30)

# Teste de velocidade do modo avançado: segundos por sentido (0 desativa) e espera inicial
SPEED_SECONDS=$(int_or "${PT_SPEED_SECONDS:-}" 8)
SPEED_DELAY=$(int_or "${PT_SPEED_DELAY:-}" 30)

case "$GATEWAY" in
    "")       GATEWAY_LABEL="(not detected)" ;;
    no-route) GATEWAY_LABEL="(no default route)" ;;
    no-via)  GATEWAY_LABEL="(route without gateway)" ;;
    *)        GATEWAY_LABEL="$GATEWAY" ;;
esac

if command -v traceroute >/dev/null 2>&1; then ROUTE_TOOL="traceroute"; else ROUTE_TOOL="tracepath"; fi

if (( SHOW_HELP )); then
    cat <<EOF
Usage: $(basename "$0") [-a | --advanced] [-h | --help]

Opens the tmux session '$SESSION' with six diagnostic panes:
  Gateway   ping -c5 $GATEWAY_LABEL
  Ping      ping -c5 $PING_1
  Ping      ping -c5 $PING_2
  DNS       $PING_DNS via system DNS and @$DNS_SERVER
  HTTP      $HTTP_URL + captive portal check
  Route     $ROUTE_TOOL -n $TRACE

Ping latency: OK up to ${LAT_SLOW} ms, very slow above ${LAT_VERY_SLOW} ms,
unstable with jitter above ${JITTER_MAX} ms.

-a, --advanced adds two tabs (switch with Ctrl+b n / Ctrl+b p):
  advanced  Interface   Wi-Fi signal or cable speed, interface errors
            Public IP   public IPv4 and IPv6 connectivity
            MTU         path MTU to $PING_1
            DNS speed   system resolver vs 1.1.1.1, 8.8.8.8 and 9.9.9.9
            Ports       outbound TCP ports (53, 80, 443, 22, 587, ...) and QUIC
            MTR         per-hop packet loss to $TRACE, CGNAT and double NAT
  speed     download/upload and bufferbloat, ${SPEED_SECONDS}s each way after ${SPEED_DELAY}s
            (uses data: up to a few hundred MB on fast links; PT_SPEED_SECONDS=0 skips it)

Environment variables: PT_GATEWAY, PT_PING_1, PT_PING_2, PT_PING_DNS,
PT_DNS_SERVER, PT_HTTP_URL, PT_PORTAL_URL, PT_TRACE,
PT_LAT_SLOW, PT_LAT_VERY_SLOW, PT_JITTER, PT_SPEED_SECONDS, PT_SPEED_DELAY
EOF
    exit 0
fi

# Verifica dependências obrigatórias (dig e curl são opcionais)
missing=()
for cmd in tmux ping; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
if ! command -v traceroute >/dev/null 2>&1 && ! command -v tracepath >/dev/null 2>&1; then
    missing+=("traceroute or tracepath")
fi
if (( ${#missing[@]} )); then
    echo "Error: missing dependencies: ${missing[*]}" >&2
    echo "" >&2
    echo "💡 Most likely fix: install the missing packages." >&2
    hint=$(install_hint "${missing[@]/traceroute or tracepath/traceroute}")
    if [[ "$hint" == '#'* ]]; then echo "     $hint" >&2; else echo "     \$ $hint" >&2; fi
    echo "   See the README for other distributions." >&2
    exit 1
fi

# Monta o comando de um painel; ao terminar, o painel cai na shell do usuário
pane_cmd() {
    local cmd
    printf -v cmd '%q ' "$@"
    printf '%s; exec %q' "$cmd" "${SHELL:-bash}"
}

# O prefixo '=' força correspondência exata do nome da sessão
# (sem ele, '-t pt' casaria com qualquer sessão iniciada por "pt", ex.: "ptolemy")
TARGET="=$SESSION"

# Renomeia a sessão anterior em vez de encerrá-la já: se o script estiver rodando
# dentro dela, encerrá-la agora mataria o próprio script antes de criar a nova
OLD=""
if tmux has-session -t "$TARGET" 2>/dev/null; then
    OLD="${SESSION}-old-$$"
    tmux rename-session -t "$TARGET" "$OLD"
fi

# Cria a nova sessão e armazena os IDs únicos dos painéis (compatível com base-index 0 e 1)
if ! LAST=$(tmux new-session -d -s "$SESSION" -P -F '#{pane_id}' \
        "$(pane_cmd "$SELF" --pane gateway "$GATEWAY")"); then
    echo "Error: could not create the tmux session '$SESSION'." >&2
    echo "" >&2
    echo "💡 Most likely fix: a broken or stale tmux server/socket; inspect it first." >&2
    echo "     \$ tmux ls" >&2
    echo "     \$ tmux -V" >&2
    echo "     # Last resort (closes ALL your tmux sessions):" >&2
    echo "     \$ tmux kill-server" >&2
    [[ -n "$OLD" ]] && tmux rename-session -t "=$OLD" "$SESSION"
    exit 1
fi
FIRST="$LAST"
# Opções de sessão usam o ID ($N): o tmux 3.4 não aceita "=nome" no set-option
SESSION_ID=$(tmux display-message -p -t "$FIRST" '#{session_id}')
tmux set-option -p -t "$LAST" @pt_title "Gateway $GATEWAY_LABEL" 2>/dev/null || true

# Adiciona um painel após o último e reorganiza em grade a cada passo,
# para que a sessão (criada com tamanho padrão) sempre tenha espaço
add_pane() {
    local title="$1"
    shift
    LAST=$(tmux split-window -t "$LAST" -P -F '#{pane_id}' "$(pane_cmd "$@")")
    tmux select-layout -t "$LAST" tiled >/dev/null
    tmux set-option -p -t "$LAST" @pt_title "$title" 2>/dev/null || true
}

add_pane "Ping $PING_1"     "$SELF" --pane ping "$PING_1" "$LAT_SLOW" "$LAT_VERY_SLOW" "$JITTER_MAX"
add_pane "Ping $PING_2"     "$SELF" --pane ping "$PING_2" "$LAT_SLOW" "$LAT_VERY_SLOW" "$JITTER_MAX"
add_pane "DNS $PING_DNS"    "$SELF" --pane dns "$PING_DNS" "$DNS_SERVER"
add_pane "HTTP"             "$SELF" --pane http "$HTTP_URL" "$PORTAL_URL"
add_pane "Route $TRACE ($ROUTE_TOOL)" "$SELF" --pane route "$TRACE"

# Identifica cada painel da janela na borda superior
label_panes() {
    tmux set-option -w -t "$1" pane-border-status top >/dev/null 2>&1 || true
    tmux set-option -w -t "$1" pane-border-format ' #{@pt_title} ' >/dev/null 2>&1 || true
}

# Abre uma nova aba (janela tmux) em segundo plano com um primeiro painel
add_window() {
    local name="$1" title="$2"
    shift 2
    LAST=$(tmux new-window -d -t "$TARGET:" -n "$name" -P -F '#{pane_id}' "$(pane_cmd "$@")")
    tmux set-option -p -t "$LAST" @pt_title "$title" 2>/dev/null || true
    label_panes "$LAST"
}

label_panes "$FIRST"
tmux select-pane -t "$FIRST"

if (( ADVANCED )); then
    tmux rename-window -t "$FIRST" basic
    add_window advanced "Interface"  "$SELF" --pane iface
    add_pane "Public IP / IPv6"      "$SELF" --pane ip
    add_pane "MTU $PING_1"           "$SELF" --pane mtu "$PING_1"
    add_pane "DNS speed"             "$SELF" --pane dnsbench
    add_pane "Ports"                 "$SELF" --pane ports
    add_pane "MTR $TRACE"            "$SELF" --pane mtr "$TRACE"
    if (( SPEED_SECONDS > 0 )); then
        add_window speed "Speed and bufferbloat" \
            "$SELF" --pane speed "$SPEED_SECONDS" "$SPEED_DELAY" "$PING_1" "$GATEWAY"
    fi
    # Barra de status com as abas e o atalho para alternar entre elas
    tmux set-option -t "$SESSION_ID" status on >/dev/null 2>&1 || true
    tmux set-option -t "$SESSION_ID" status-right ' Ctrl+b n/p: next/previous tab ' >/dev/null 2>&1 || true
    tmux set-option -t "$SESSION_ID" status-right-length 40 >/dev/null 2>&1 || true
else
    tmux set-option -t "$SESSION_ID" status off >/dev/null 2>&1 || true
fi

# Conecta à sessão e só então descarta a anterior
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$TARGET" 2>/dev/null || true
    # Último passo: se o script roda dentro da sessão antiga, ele termina aqui
    [[ -n "$OLD" ]] && tmux kill-session -t "=$OLD" 2>/dev/null
    exit 0
else
    [[ -n "$OLD" ]] && tmux kill-session -t "=$OLD" 2>/dev/null
    exec tmux attach-session -t "$TARGET"
fi
